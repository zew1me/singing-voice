#!/usr/bin/env bash
set -euo pipefail

if (( $# > 1 )); then
    printf 'Usage: %s [git-revision]\n' "$0" >&2
    exit 2
fi

cd "$(git rev-parse --show-toplevel)"
commit=$(git rev-parse --verify --end-of-options "${1:-HEAD}^{commit}")
image="singing-voice:preflight-${commit:0:12}"

printf 'Building %s from %s for linux/amd64\n' "$image" "$commit"
git archive "$commit" | docker buildx build \
    --platform linux/amd64 --progress=plain --load \
    -f runpod_worker/Dockerfile -t "$image" -

docker run --rm --platform linux/amd64 --network none --entrypoint python "$image" \
    -c 'import runpod; from runpod_worker.handler import handler; assert callable(handler); print("Worker imports OK")'
